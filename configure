set +x
set -e

which cmake

setup_reference_example() {
    _setup_reference_example_file="inst/extdata/example_ref.fasta"

    if [ ! -f ${_setup_reference_example_file} ]; then
        gunzip "${_setup_reference_example_file}.gz"
    fi
}

download_CLONES() {
    if [ ! -d CLONES ]; then

        git clone https://github.com/albertocasagrande/CLONES.git

        (cd CLONES; git checkout aafe01b && rm -rf .git )
    fi
}

setup_reference_example

download_CLONES

RSCRIPT="${R_HOME}/bin/Rscript"

echo ${ls}

${RSCRIPT} --vanilla template_doc/setup_common_doc.R

${R_HOME}/bin/R --vanilla --silent -e 'Rcpp::compileAttributes()'
