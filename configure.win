set +x
set -e

which cmake

setup_reference_example() {
    _setup_reference_example_file="inst/extdata/example_ref.fasta.gz"

    if [ -f ${_setup_reference_example_file} ]; then
        gunzip ${_setup_reference_example_file}
    fi
}

download_CLONES() {
    if [ ! -d CLONES ]; then

        git clone https://github.com/albertocasagrande/CLONES.git

        (cd CLONES; git checkout d23df38 && rm -rf .git )
    fi
}

setup_reference_example

download_CLONES

${R_HOME}/bin/R --vanilla --silent -e 'Rcpp::compileAttributes()'
